## Generated by server/autogen.sh (libtoolize, aclocal, autoheader, autoconf, automake)
/server/configure
/server/aclocal.m4
/server/autom4te.cache/
/server/config.h.in
Makefile.in
# automake --add-missing copies its aux scripts in here; the empty .gitignore is the
# placeholder that keeps the directory in the repository, so it stays.
/server/config/*
!/server/config/.gitignore

## Generated by configure and make when building in the source tree
/server/Makefile
/server/cmserver/Makefile
/server/cmserver/conf/Makefile
/server/external/Makefile
/server/config.h
/server/config.log
/server/config.status
/server/libtool
/server/stamp-h1
.deps/
.libs/
*.o
*.lo
*.la
/server/cmserver/cm_admin
/server/cmserver/cub_manager

## Unpacked and installed by server/build_external.sh
/server/external/libevent-*/
/server/external/jsoncpp-src-*/
/server/external/openssl-*/
/server/bin/
/server/lib/
/server/include/

## CMake build (server/build_cmake.sh), named build_<arch>_<mode> like the server's
/server/build_*/

## For Test
server/test/log/
server/test/__pycache__/
server/test/task_test_case/*/*/*.result
server/test/*.log
server/test/csql.*
!server/test/task_test_config/*.log
